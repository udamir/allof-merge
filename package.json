{
  "name": "allof-merge",
  "version": "1.0.1",
  "description": "Merge allOf in JSON Schema, OpenAPI, AsyncAPI and GraphApi documents into equivalent schemas without allOf",
  "keywords": [
    "json",
    "schema",
    "json-schema",
    "jsonschema",
    "openapi",
    "swagger",
    "asyncapi",
    "graphapi",
    "allof",
    "merge",
    "resolve",
    "simplify"
  ],
  "homepage": "https://github.com/udamir/allof-merge#readme",
  "bugs": {
    "url": "https://github.com/udamir/allof-merge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udamir/allof-merge.git"
  },
  "license": "MIT",
  "author": "Damir Yusipov",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "test:fuzz": "vp test run test/fuzz",
    "typecheck": "tsc",
    "lint": "vp lint",
    "check": "tsc && vp lint",
    "prepublishOnly": "pnpm run check && pnpm test && pnpm run build"
  },
  "dependencies": {
    "json-crawl": "^1.2.0"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "ajv": "^8.17.1",
    "fast-check": "^4.10.2",
    "gqlapi": "^0.5.1",
    "graphql": "^16.8.1",
    "js-yaml": "^4.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0"
}
